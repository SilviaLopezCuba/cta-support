			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="62" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="5" bottomPadding="3" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{numero} == null || $F{numero}.toString().trim().isEmpty() ? "—" : $F{numero}.toString()]]></textFieldExpression></textField>
