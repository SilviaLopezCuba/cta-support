<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeMaterial" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="SUBTITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT (s.numero)::text AS numero,
       (to_char(s.fecha_solicitud, 'DD/MM/YYYY HH24:MI'))::text AS fecha,
       (CASE WHEN s.tipo_orden = 'T' THEN COALESCE((SELECT 'Ticket ' || t.numero_ticket FROM public.ticket t WHERE t.id_ticket = s.id_orden), 'Ticket') ELSE COALESCE((SELECT 'Mant. ' || m.numero_mantenimiento FROM public.mantenimientos_preventivos m WHERE m.id_mantenimiento = s.id_orden), 'Mant.') END)::text AS orden,
       (COALESCE(p.apellido || ', ' || p.nombre, u.login))::text AS tecnico,
       (CASE s.prioridad WHEN 'Critica' THEN 'Crítica' ELSE s.prioridad END)::text AS prioridad,
       (CASE WHEN s.estado IN ('Pendiente', 'En espera') AND vs.hay_stock THEN s.estado || ' (hay stock)' ELSE s.estado END)::text AS estado,
       ((SELECT string_agg(COALESCE(cr.nombre, ci.nombre) || ': ' || replace(rtrim(to_char(d.cantidad_solicitada, 'FM999999990.99'), '.'), '.', ',') || ' / ' || replace(rtrim(to_char(d.cantidad_entregada, 'FM999999990.99'), '.'), '.', ','), ', ' ORDER BY d.id_detalle) FROM public.solicitudes_material_detalle d LEFT JOIN public.catalogo_repuestos cr ON d.tipo_articulo = 'R' AND cr.id_repuesto = d.id_articulo LEFT JOIN public.catalogo_insumos ci ON d.tipo_articulo = 'I' AND ci.id_insumo = d.id_articulo WHERE d.id_solicitud = s.id_solicitud))::text AS articulos,
       (replace(rtrim(to_char(round((EXTRACT(EPOCH FROM (COALESCE(s.fecha_entrega, now()) - s.fecha_solicitud)) / 86400.0)::numeric, 1), 'FM999999990.99'), '.'), '.', ','))::text AS dias,
       (COALESCE(s.motivo_rechazo, s.observacion_entrega, ''))::text AS comentario
FROM public.solicitudes_material s JOIN public.usuarios u ON u.id_usuario = s.id_usuario_solicita LEFT JOIN public.personas p ON p.id_persona = u.id_persona LEFT JOIN public.v_solicitud_stock vs ON vs.id_solicitud = s.id_solicitud WHERE s.fecha_solicitud::date BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date)
  AND ($P!{FILTROS})
ORDER BY s.fecha_solicitud, s.id_solicitud]]>
	</queryString>
	<field name="numero" class="java.lang.String"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="orden" class="java.lang.String"/>
	<field name="tecnico" class="java.lang.String"/>
	<field name="prioridad" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="articulos" class="java.lang.String"/>
	<field name="dias" class="java.lang.String"/>
	<field name="comentario" class="java.lang.String"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
