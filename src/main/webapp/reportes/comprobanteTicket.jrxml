	<field name="solicitante" class="java.lang.String"/>
	<field name="sol_documento" class="java.lang.String"/>
	<field name="sol_telefono" class="java.lang.String"/>
	<field name="sol_correo" class="java.lang.String"/>
	<field name="sol_rol" class="java.lang.String"/>
	<field name="tecnico" class="java.lang.String"/>
	<field name="tec_telefono" class="java.lang.String"/>
	<field name="nombre_especialidad" class="java.lang.String"/>
	<field name="registrado_por" class="java.lang.String"/>
	<field name="fecha_creacion" class="java.sql.Timestamp"/>
	<field name="fecha_inicio" class="java.sql.Timestamp"/>
	<field name="fecha_fin" class="java.sql.Timestamp"/>
	<field name="fecha_seguimiento" class="java.sql.Timestamp"/>
	<field name="tiempo_resolucion" class="java.lang.Integer"/>
	<field name="fecha_vencimiento_garantia" class="java.sql.Date"/>
	<title>
		<band height="68" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank"><reportElement x="0" y="2" width="92" height="46"/><imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression></image>
			<staticText><reportElement x="104" y="4" width="261" height="24" forecolor="#14284B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Comprobante de Ticket]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="104" y="28" width="261" height="16" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["N\u00b0 " + $F{numero_ticket} + " \u2014 Estado: " + $F{estado} + "   |   Prioridad: " + $F{prioridad}]]></textFieldExpression></textField>
			<textField><reportElement x="365" y="10" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="365" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{USUARIO_IMPRESION} == null ? "" : "Por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression></textField>
