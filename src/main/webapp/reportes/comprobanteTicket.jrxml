<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteTicket" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="30">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_TICKET" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<queryString><![CDATA[SELECT t.id_ticket, t.numero_ticket, t.estado, t.prioridad, t.tipo_falla, t.descripcion, t.diagnostico, t.observacion_final,
 t.fecha_creacion, t.fecha_inicio, t.fecha_fin, t.fecha_seguimiento, t.tiempo_resolucion,
 s.nombre_sala, s.ubicacion_piso,
 e.codigo_patrimonial, e.modelo, e.nro_serie, e.fecha_vencimiento_garantia, m.nombre_marca, c.nombre_categoria, ee.nombre_estado,
 psol.apellido || ', ' || psol.nombre AS solicitante, psol.documento AS sol_documento, psol.telefono AS sol_telefono, psol.correo AS sol_correo, rsol.nombre_rol AS sol_rol,
 ptec.apellido || ', ' || ptec.nombre AS tecnico, ptec.telefono AS tec_telefono, esp.nombre_especialidad,
 (SELECT p.apellido || ', ' || p.nombre FROM public.ticket_detalle d JOIN public.usuarios u ON d.id_usuario = u.id_usuario
   JOIN public.personas p ON u.id_persona = p.id_persona WHERE d.id_ticket = t.id_ticket ORDER BY d.fecha DESC, d.id_detalle DESC LIMIT 1) AS registrado_por
FROM public.ticket t
LEFT JOIN public.salas s ON t.id_sala = s.id_sala
LEFT JOIN public.equipos e ON t.id_equipo = e.id_equipo
LEFT JOIN public.marcas m ON e.id_marca = m.id_marca
LEFT JOIN public.categorias c ON e.id_categoria = c.id_categoria
LEFT JOIN public.estados_equipo ee ON e.id_estado = ee.id_estado
LEFT JOIN public.tecnicos tc ON t.id_tecnico_asignado = tc.id_tecnico
LEFT JOIN public.especialidades esp ON tc.id_especialidad = esp.id_especialidad
LEFT JOIN public.usuarios utec ON tc.id_usuario = utec.id_usuario
LEFT JOIN public.personas ptec ON utec.id_persona = ptec.id_persona
LEFT JOIN public.usuarios usol ON t.id_usuario_solicita = usol.id_usuario
LEFT JOIN public.personas psol ON usol.id_persona = psol.id_persona
LEFT JOIN public.roles rsol ON t.id_rol_solicita = rsol.id_rol
WHERE t.id_ticket = $P{ID_TICKET}]]></queryString>
