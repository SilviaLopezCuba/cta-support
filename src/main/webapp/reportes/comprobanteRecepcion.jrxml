<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteRecepcion" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="30">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_RECEPCION" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<queryString><![CDATA[SELECT r.id_recepcion, r.numero_recepcion, r.fecha_recepcion, r.nro_comprobante, r.estado, r.observacion, r.fecha_confirmacion,
 c.nombre_concepto, d.nombre, d.documento, d.telefono, d.email,
 pr.apellido || ', ' || pr.nombre AS registrado_por,
 pc.apellido || ', ' || pc.nombre AS confirmado_por,
 (SELECT COALESCE(SUM(x.cantidad), 0) FROM public.recepciones_detalle_equipos x WHERE x.id_recepcion = r.id_recepcion)::integer AS cant_equipos,
 ((SELECT COALESCE(SUM(x.cantidad * x.costo_unitario), 0) FROM public.recepciones_detalle_equipos x WHERE x.id_recepcion = r.id_recepcion)
 + (SELECT COALESCE(SUM(x.cantidad * x.costo_unitario), 0) FROM public.recepciones_detalle_articulos x WHERE x.id_recepcion = r.id_recepcion)) AS total
FROM public.recepciones r
JOIN public.conceptos_entrada c ON c.id_concepto = r.id_concepto
JOIN public.donantes d ON d.id_donante = r.id_donante
LEFT JOIN public.usuarios ur ON ur.id_usuario = r.id_usuario_registro LEFT JOIN public.personas pr ON pr.id_persona = ur.id_persona
LEFT JOIN public.usuarios uc ON uc.id_usuario = r.id_usuario_confirma LEFT JOIN public.personas pc ON pc.id_persona = uc.id_persona
WHERE r.id_recepcion = $P{ID_RECEPCION}]]></queryString>
	<field name="id_recepcion" class="java.lang.Integer"/>
	<field name="numero_recepcion" class="java.lang.String"/>
	<field name="fecha_recepcion" class="java.sql.Date"/>
	<field name="nro_comprobante" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="fecha_confirmacion" class="java.sql.Timestamp"/>
	<field name="nombre_concepto" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="documento" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="registrado_por" class="java.lang.String"/>
	<field name="confirmado_por" class="java.lang.String"/>
	<field name="cant_equipos" class="java.lang.Integer"/>
	<field name="total" class="java.math.BigDecimal"/>
	<title>
		<band height="68" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank"><reportElement x="0" y="2" width="92" height="46"/><imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression></image>
			<staticText><reportElement x="104" y="4" width="261" height="24" forecolor="#14284B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Acta de Recepción]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="104" y="28" width="261" height="16" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["N\u00b0 " + $F{numero_recepcion} + " \u2014 " + $F{nombre_concepto}]]></textFieldExpression></textField>
			<textField><reportElement x="365" y="10" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="365" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{USUARIO_IMPRESION} == null ? "" : "Por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression></textField>
			<rectangle><reportElement x="0" y="54" width="178" height="3" forecolor="#B01E35" backcolor="#B01E35"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="178" y="54" width="178" height="3" forecolor="#AAB4C0" backcolor="#AAB4C0"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="356" y="54" width="179" height="3" forecolor="#1F5BA8" backcolor="#1F5BA8"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		</band>
	</title>
