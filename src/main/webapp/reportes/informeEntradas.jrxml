<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeEntradas" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="SUBTITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT (r.numero_recepcion)::text AS numero,
       (to_char(r.fecha_recepcion, 'DD/MM/YYYY'))::text AS fecha,
       (ce.nombre_concepto)::text AS concepto,
       (COALESCE(d.nombre, '—'))::text AS donante,
       (COALESCE(r.nro_comprobante, '—'))::text AS comprobante,
       ((SELECT string_agg(COALESCE(cr.nombre, ci.nombre) || ' x' || replace(rtrim(to_char(x.cantidad, 'FM999999990.99'), '.'), '.', ','), ', ' ORDER BY x.id_detalle) FROM public.recepciones_detalle_articulos x LEFT JOIN public.catalogo_repuestos cr ON cr.id_repuesto = x.id_repuesto LEFT JOIN public.catalogo_insumos ci ON ci.id_insumo = x.id_insumo WHERE x.id_recepcion = r.id_recepcion))::text AS articulos,
       ((SELECT string_agg(COALESCE(cat.nombre_categoria, 'Equipo') || COALESCE(' ' || y.modelo, '') || ' x' || y.cantidad, ', ' ORDER BY y.id_detalle) FROM public.recepciones_detalle_equipos y LEFT JOIN public.categorias cat ON cat.id_categoria = y.id_categoria WHERE y.id_recepcion = r.id_recepcion))::text AS equipos,
       (replace(to_char(round((COALESCE((SELECT SUM(x.cantidad * COALESCE(x.costo_unitario, 0)) FROM public.recepciones_detalle_articulos x WHERE x.id_recepcion = r.id_recepcion), 0) + COALESCE((SELECT SUM(y.cantidad * COALESCE(y.costo_unitario, 0)) FROM public.recepciones_detalle_equipos y WHERE y.id_recepcion = r.id_recepcion), 0))), 'FM999,999,999,990'), ',', '.'))::text AS valor
FROM public.recepciones r LEFT JOIN public.conceptos_entrada ce ON ce.id_concepto = r.id_concepto LEFT JOIN public.donantes d ON d.id_donante = r.id_donante WHERE r.estado = 'Confirmada' AND r.fecha_recepcion BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date)
  AND ($P!{FILTROS})
ORDER BY r.fecha_recepcion, r.id_recepcion]]>
	</queryString>
	<field name="numero" class="java.lang.String"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="concepto" class="java.lang.String"/>
	<field name="donante" class="java.lang.String"/>
	<field name="comprobante" class="java.lang.String"/>
	<field name="articulos" class="java.lang.String"/>
	<field name="equipos" class="java.lang.String"/>
	<field name="valor" class="java.lang.String"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
