<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeMovimientosStock" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="SUBTITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT (to_char(m.fecha, 'DD/MM/YYYY HH24:MI'))::text AS fecha,
       (CASE m.tipo_movimiento WHEN 'ENTRADA' THEN 'Entrada por recepción' WHEN 'ENTREGA' THEN 'Entrega a técnico' WHEN 'DEVOLUCION' THEN 'Devolución del técnico' WHEN 'AJUSTE' THEN 'Ajuste de inventario' WHEN 'SALDO INICIAL' THEN 'Saldo inicial' WHEN 'DAÑO' THEN 'Daño' WHEN 'SALIDA' THEN 'Salida' ELSE initcap(lower(m.tipo_movimiento)) END)::text AS movimiento,
       (COALESCE(r.nombre, i.nombre, '—'))::text AS articulo,
       (CASE m.tipo_articulo WHEN 'R' THEN 'Repuesto' ELSE 'Insumo' END)::text AS tipo,
       (CASE WHEN m.cantidad > 0 THEN replace(rtrim(to_char(m.cantidad, 'FM999999990.99'), '.'), '.', ',') ELSE '' END)::text AS entra,
       (CASE WHEN m.cantidad < 0 THEN replace(rtrim(to_char(-m.cantidad, 'FM999999990.99'), '.'), '.', ',') ELSE '' END)::text AS sale,
       (replace(rtrim(to_char(m.stock_nuevo, 'FM999999990.99'), '.'), '.', ','))::text AS saldo,
       (COALESCE(m.observacion, ''))::text AS documento,
       (COALESCE(p.apellido || ', ' || p.nombre, u.login, '—'))::text AS usuario
FROM public.movimientos_stock m LEFT JOIN public.catalogo_repuestos r ON m.tipo_articulo = 'R' AND r.id_repuesto = m.id_articulo LEFT JOIN public.catalogo_insumos i ON m.tipo_articulo = 'I' AND i.id_insumo = m.id_articulo LEFT JOIN public.usuarios u ON u.id_usuario = m.id_usuario LEFT JOIN public.personas p ON p.id_persona = u.id_persona WHERE m.fecha::date BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date)
  AND ($P!{FILTROS})
ORDER BY m.fecha, m.id_movimiento]]>
	</queryString>
	<field name="fecha" class="java.lang.String"/>
	<field name="movimiento" class="java.lang.String"/>
	<field name="articulo" class="java.lang.String"/>
	<field name="tipo" class="java.lang.String"/>
	<field name="entra" class="java.lang.String"/>
	<field name="sale" class="java.lang.String"/>
	<field name="saldo" class="java.lang.String"/>
	<field name="documento" class="java.lang.String"/>
	<field name="usuario" class="java.lang.String"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
