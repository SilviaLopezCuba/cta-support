			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="80" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="5" bottomPadding="3" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{fecha} == null || $F{fecha}.toString().trim().isEmpty() ? "—" : $F{fecha}.toString()]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="80" y="0" width="120" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="5" bottomPadding="3" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{movimiento} == null || $F{movimiento}.toString().trim().isEmpty() ? "—" : $F{movimiento}.toString()]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="200" y="0" width="190" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="5" bottomPadding="3" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{articulo} == null || $F{articulo}.toString().trim().isEmpty() ? "—" : $F{articulo}.toString()]]></textFieldExpression></textField>
