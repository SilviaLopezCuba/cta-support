<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeMovimientosEquipos" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="SUBTITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT (mv.numero)::text AS numero,
       (to_char(mv.fecha, 'DD/MM/YYYY'))::text AS fecha,
       (CASE mv.tipo WHEN 'ASIGNACION' THEN 'Asignación a sala' WHEN 'RETIRO' THEN 'Retiro al depósito' WHEN 'BAJA' THEN 'Baja / inactivación' WHEN 'REACTIVACION' THEN 'Reactivación' ELSE mv.tipo END)::text AS movimiento,
       ((SELECT string_agg(COALESCE(dd.codigo_patrimonial, e.codigo_patrimonial, 'S/N') || COALESCE(' ' || e.modelo, ''), ', ' ORDER BY dd.id_detalle) FROM public.movimientos_equipos_detalle dd LEFT JOIN public.equipos e ON e.id_equipo = dd.id_equipo WHERE dd.id_movimiento = mv.id_movimiento))::text AS equipos,
       (COALESCE((SELECT string_agg(DISTINCT so.nombre_sala, ', ') FROM public.movimientos_equipos_detalle dd JOIN public.salas so ON so.id_sala = dd.id_sala_origen WHERE dd.id_movimiento = mv.id_movimiento), '—'))::text AS desde,
       (COALESCE(sd.nombre_sala, CASE WHEN mv.tipo = 'BAJA' THEN 'Queda en su sala' ELSE '—' END))::text AS hacia,
       (COALESCE(mi.nombre_motivo, ''))::text AS motivo,
       (COALESCE(mv.origen, ''))::text AS origen,
       (COALESCE(p.apellido || ', ' || p.nombre, u.login, '—'))::text AS usuario
FROM public.movimientos_equipos mv LEFT JOIN public.salas sd ON sd.id_sala = mv.id_sala_destino LEFT JOIN public.motivos_inactivo mi ON mi.id_motivo = mv.id_motivo LEFT JOIN public.usuarios u ON u.id_usuario = mv.id_usuario LEFT JOIN public.personas p ON p.id_persona = u.id_persona WHERE mv.fecha BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date)
  AND ($P!{FILTROS})
ORDER BY mv.fecha, mv.id_movimiento]]>
	</queryString>
	<field name="numero" class="java.lang.String"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="movimiento" class="java.lang.String"/>
	<field name="equipos" class="java.lang.String"/>
	<field name="desde" class="java.lang.String"/>
	<field name="hacia" class="java.lang.String"/>
	<field name="motivo" class="java.lang.String"/>
	<field name="origen" class="java.lang.String"/>
	<field name="usuario" class="java.lang.String"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
