	<parameter name="P_GENERADOR_ROL" class="java.lang.String">
		<defaultValueExpression><![CDATA[""]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT i.id_insumo, i.nombre, m.nombre_marca, u.nombre_unidad, i.stock, i.stock_minimo FROM public.catalogo_insumos i JOIN public.marcas m ON i.id_marca = m.id_marca JOIN public.unidades_medida u ON i.id_unidad = u.id_unidad ORDER BY i.id_insumo ASC]]>
	</queryString>
