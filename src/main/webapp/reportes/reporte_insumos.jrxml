			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="369" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{P_GENERADOR_NOMBRE} == null || $P{P_GENERADOR_NOMBRE}.equals("-") ? "" : "Por: " + $P{P_GENERADOR_NOMBRE} + ($P{P_GENERADOR_ROL} != null && $P{P_GENERADOR_ROL}.length() > 0 ? " (" + $P{P_GENERADOR_ROL} + ")" : "")]]></textFieldExpression></textField>
