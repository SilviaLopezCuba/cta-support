<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteTicketHistorial" language="groovy" pageWidth="535" pageHeight="842" columnWidth="535"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="NoDataSection" isIgnorePagination="true">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_TICKET" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT d.fecha, d.accion, COALESCE(p.apellido || ', ' || p.nombre, 'Sistema') AS usuario, REPLACE(d.descripcion, '→', '->') AS descripcion FROM public.ticket_detalle d
 LEFT JOIN public.usuarios u ON d.id_usuario = u.id_usuario LEFT JOIN public.personas p ON u.id_persona = p.id_persona
 WHERE d.id_ticket = $P{ID_TICKET} ORDER BY d.fecha, d.id_detalle]]></queryString>
	<field name="fecha" class="java.sql.Timestamp"/>
	<field name="accion" class="java.lang.String"/>
	<field name="usuario" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<columnHeader><band height="18">
<staticText><reportElement x="0" y="0" width="80" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Fecha]]></text></staticText>
<staticText><reportElement x="80" y="0" width="110" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Acción]]></text></staticText>
<staticText><reportElement x="190" y="0" width="120" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Usuario]]></text></staticText>
<staticText><reportElement x="310" y="0" width="225" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Descripción]]></text></staticText>
	</band></columnHeader>
	<detail><band height="16" splitType="Stretch">
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="80" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{fecha} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha}) : "-"]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="80" y="0" width="110" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{accion} != null && !$F{accion}.toString().trim().isEmpty()) ? $F{accion}.toString() : "-"]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="190" y="0" width="120" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{usuario} != null && !$F{usuario}.toString().trim().isEmpty()) ? $F{usuario}.toString() : "-"]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="310" y="0" width="225" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{descripcion} != null && !$F{descripcion}.toString().trim().isEmpty()) ? $F{descripcion}.toString() : "-"]]></textFieldExpression></textField>
	</band></detail>
	<noData><band height="18">
<staticText><reportElement x="0" y="0" width="535" height="18" positionType="FixRelativeToTop" forecolor="#56637A"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Sin acciones registradas.]]></text></staticText>
	</band></noData>
</jasperReport>
