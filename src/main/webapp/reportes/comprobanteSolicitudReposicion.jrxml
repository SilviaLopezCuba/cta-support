t" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{usu_apellido} != null && !$F{usu_apellido}.toString().trim().isEmpty()) ? ($F{usu_apellido} + ", " + $F{usu_nombre}) : "-"]]></textFieldExpression></textField></frame>
