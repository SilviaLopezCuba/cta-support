<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteSolicitudReposicion" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="30">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_SOLICITUD" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<queryString><![CDATA[SELECT s.id_solicitud, s.numero_solicitud, s.fecha_solicitud, s.estado, s.observaciones,
 p.nombre AS usu_nombre, p.apellido AS usu_apellido,
 (SELECT COUNT(*) FROM public.solicitudes_compra_detalle d WHERE d.id_solicitud = s.id_solicitud) AS items,
 COALESCE(dn.nombre, '-') AS institucion
FROM public.solicitudes_compra s
LEFT JOIN public.donantes dn ON dn.id_donante = s.id_donante
LEFT JOIN public.usuarios u ON s.id_usuario_solicita = u.id_usuario
LEFT JOIN public.personas p ON u.id_persona = p.id_persona
WHERE s.id_solicitud = $P{ID_SOLICITUD}]]></queryString>
	<field name="id_solicitud" class="java.lang.Integer"/>
	<field name="numero_solicitud" class="java.lang.String"/>
	<field name="fecha_solicitud" class="java.sql.Timestamp"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="usu_nombre" class="java.lang.String"/>
	<field name="usu_apellido" class="java.lang.String"/>
	<field name="items" class="java.lang.Long"/>
	<field name="institucion" class="java.lang.String"/>
	<title>
		<band height="68" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank"><reportElement x="0" y="2" width="92" height="46"/><imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression></image>
			<staticText><reportElement x="104" y="4" width="261" height="24" forecolor="#14284B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Solicitud de Reposición]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="104" y="28" width="261" height="16" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["N\u00b0 " + $F{numero_solicitud} + " \u2014 Estado: " + $F{estado}]]></textFieldExpression></textField>
			<textField><reportElement x="365" y="10" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="365" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{USUARIO_IMPRESION} == null ? "" : "Por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression></textField>
			<rectangle><reportElement x="0" y="54" width="178" height="3" forecolor="#B01E35" backcolor="#B01E35"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="178" y="54" width="178" height="3" forecolor="#AAB4C0" backcolor="#AAB4C0"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="356" y="54" width="179" height="3" forecolor="#1F5BA8" backcolor="#1F5BA8"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		</band>
	</title>
