<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteSolicitudReposicionDetalle" language="groovy" pageWidth="535" pageHeight="842" columnWidth="535"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="NoDataSection" isIgnorePagination="true">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_SOLICITUD" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT CASE WHEN d.id_repuesto IS NOT NULL THEN 'Repuesto' ELSE 'Insumo' END AS categoria,
 COALESCE(r.nombre, i.nombre) AS descripcion, d.stock_actual, d.stock_minimo, d.cantidad_solicitada,
 d.cantidad_recibida, GREATEST(d.cantidad_solicitada - d.cantidad_recibida, 0) AS cantidad_pendiente
FROM public.solicitudes_compra_detalle d
LEFT JOIN public.catalogo_repuestos r ON d.id_repuesto = r.id_repuesto
LEFT JOIN public.catalogo_insumos i ON d.id_insumo = i.id_insumo
WHERE d.id_solicitud = $P{ID_SOLICITUD}
ORDER BY descripcion]]></queryString>
	<field name="categoria" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="stock_actual" class="java.math.BigDecimal"/>
	<field name="stock_minimo" class="java.math.BigDecimal"/>
	<field name="cantidad_solicitada" class="java.math.BigDecimal"/>
	<field name="cantidad_recibida" class="java.math.BigDecimal"/>
	<field name="cantidad_pendiente" class="java.math.BigDecimal"/>
	<columnHeader><band height="14">
<staticText><reportElement x="0" y="0" width="60" height="14" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Categoría]]></text></staticText>
<staticText><reportElement x="60" y="0" width="185" height="14" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Artículo]]></text></staticText>
<staticText><reportElement x="245" y="0" width="65" height="14" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Stock actual]]></text></staticText>
<staticText><reportElement x="310" y="0" width="55" height="14" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Mínimo]]></text></staticText>
<staticText><reportElement x="365" y="0" width="55" height="14" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Pedido]]></text></staticText>
<staticText><reportElement x="420" y="0" width="55" height="14" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Recibido]]></text></staticText>
<staticText><reportElement x="475" y="0" width="60" height="14" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Pendiente]]></text></staticText>
	</band></columnHeader>
	<detail><band height="16" splitType="Stretch">
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="60" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{categoria} != null && !$F{categoria}.toString().trim().isEmpty()) ? $F{categoria}.toString() : "-"]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="60" y="0" width="185" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{descripcion} != null && !$F{descripcion}.toString().trim().isEmpty()) ? $F{descripcion}.toString() : "-"]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="245" y="0" width="65" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{stock_actual}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="310" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{stock_minimo}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="365" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad_solicitada}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="420" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad_recibida}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="475" y="0" width="60" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad_pendiente}]]></textFieldExpression></textField>
	</band></detail>
	<noData><band height="18">
<staticText><reportElement x="0" y="0" width="535" height="18" positionType="FixRelativeToTop" forecolor="#56637A"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Esta solicitud no tiene artículos cargados.]]></text></staticText>
	</band></noData>
</jasperReport>
