ment><textFieldExpression><![CDATA[$F{recepcion_confirmada} ? "Confirmada por el técnico el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha_confirmacion}) : "Pendiente de confirmar"]]></textFieldExpression></textField></frame>
