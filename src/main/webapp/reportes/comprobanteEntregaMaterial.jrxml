<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteEntregaMaterial" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="30">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_SOLICITUD" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<queryString><![CDATA[SELECT s.id_solicitud, s.numero, s.fecha_solicitud, s.fecha_entrega, s.estado, s.observacion, s.recepcion_confirmada, s.fecha_confirmacion,
 CASE WHEN s.tipo_orden = 'T' THEN COALESCE((SELECT 'Ticket ' || t.numero_ticket FROM public.ticket t WHERE t.id_ticket = s.id_orden), 'Ticket #' || s.id_orden)
      ELSE COALESCE((SELECT 'Mantenimiento ' || m.numero_mantenimiento FROM public.mantenimientos_preventivos m WHERE m.id_mantenimiento = s.id_orden), 'Mantenimiento #' || s.id_orden) END AS orden,
 ps.apellido || ', ' || ps.nombre AS solicitante,
 pe.apellido || ', ' || pe.nombre AS entrego
FROM public.solicitudes_material s
LEFT JOIN public.usuarios us ON us.id_usuario = s.id_usuario_solicita LEFT JOIN public.personas ps ON ps.id_persona = us.id_persona
LEFT JOIN public.usuarios ue ON ue.id_usuario = s.id_usuario_entrega LEFT JOIN public.personas pe ON pe.id_persona = ue.id_persona
WHERE s.id_solicitud = $P{ID_SOLICITUD}]]></queryString>
	<field name="id_solicitud" class="java.lang.Integer"/>
	<field name="numero" class="java.lang.String"/>
	<field name="fecha_solicitud" class="java.sql.Timestamp"/>
	<field name="fecha_entrega" class="java.sql.Timestamp"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="recepcion_confirmada" class="java.lang.Boolean"/>
	<field name="fecha_confirmacion" class="java.sql.Timestamp"/>
	<field name="orden" class="java.lang.String"/>
	<field name="solicitante" class="java.lang.String"/>
	<field name="entrego" class="java.lang.String"/>
	<title>
		<band height="68" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank"><reportElement x="0" y="2" width="92" height="46"/><imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression></image>
			<staticText><reportElement x="104" y="4" width="261" height="24" forecolor="#14284B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Acta de Entrega de Material]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="104" y="28" width="261" height="16" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["N\u00b0 " + $F{numero} + " \u2014 " + $F{orden}]]></textFieldExpression></textField>
			<textField><reportElement x="365" y="10" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="365" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{USUARIO_IMPRESION} == null ? "" : "Por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression></textField>
			<rectangle><reportElement x="0" y="54" width="178" height="3" forecolor="#B01E35" backcolor="#B01E35"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="178" y="54" width="178" height="3" forecolor="#AAB4C0" backcolor="#AAB4C0"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="356" y="54" width="179" height="3" forecolor="#1F5BA8" backcolor="#1F5BA8"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		</band>
	</title>
	<detail><band height="162" splitType="Stretch">
<staticText><reportElement x="0" y="0" width="535" height="16" positionType="Float" forecolor="#14284B" mode="Transparent"/><box leftPadding="0" rightPadding="3" bottomPadding="1"><bottomPen lineWidth="1.0" lineColor="#14284B"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="10" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Datos de la entrega]]></text></staticText>
<frame><reportElement x="0" y="18" width="535" height="14" positionType="Float"/><staticText><reportElement x="0" y="0" width="105" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject" forecolor="#56637A" mode="Opaque" backcolor="#F3F5F8"/><box leftPadding="6" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[N° pedido]]></text></staticText><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="105" y="0" width="162" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{numero}]]></textFieldExpression></textField><staticText><reportElement x="267" y="0" width="105" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject" forecolor="#56637A" mode="Opaque" backcolor="#F3F5F8"/><box leftPadding="6" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Orden de trabajo]]></text></staticText><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="372" y="0" width="163" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{orden} != null && !$F{orden}.toString().trim().isEmpty()) ? $F{orden}.toString() : "-"]]></textFieldExpression></textField></frame>
<frame><reportElement x="0" y="32" width="535" height="14" positionType="Float"/><staticText><reportElement x="0" y="0" width="105" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject" forecolor="#56637A" mode="Opaque" backcolor="#F3F5F8"/><box leftPadding="6" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Pedido el]]></text></staticText><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="105" y="0" width="162" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{fecha_solicitud} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha_solicitud}) : "-"]]></textFieldExpression></textField><staticText><reportElement x="267" y="0" width="105" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject" forecolor="#56637A" mode="Opaque" backcolor="#F3F5F8"/><box leftPadding="6" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Entregado el]]></text></staticText><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="372" y="0" width="163" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{fecha_entrega} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha_entrega}) : "-"]]></textFieldExpression></textField></frame>
<frame><reportElement x="0" y="46" width="535" height="14" positionType="Float"/><staticText><reportElement x="0" y="0" width="105" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject" forecolor="#56637A" mode="Opaque" backcolor="#F3F5F8"/><box leftPadding="6" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Solicitado por]]></text></staticText><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="105" y="0" width="162" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{solicitante} != null && !$F{solicitante}.toString().trim().isEmpty()) ? $F{solicitante}.toString() : "-"]]></textFieldExpression></textField><staticText><reportElement x="267" y="0" width="105" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject" forecolor="#56637A" mode="Opaque" backcolor="#F3F5F8"/><box leftPadding="6" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Entregado por]]></text></staticText><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="372" y="0" width="163" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{entrego} != null && !$F{entrego}.toString().trim().isEmpty()) ? $F{entrego}.toString() : "-"]]></textFieldExpression></textField></frame>
