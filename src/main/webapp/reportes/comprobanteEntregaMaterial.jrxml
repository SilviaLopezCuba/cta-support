<staticText><reportElement x="0" y="94" width="535" height="16" positionType="Float" forecolor="#14284B" mode="Transparent"/><box leftPadding="0" rightPadding="3" bottomPadding="1"><bottomPen lineWidth="1.0" lineColor="#14284B"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="10" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Material entregado]]></text></staticText>
<subreport><reportElement x="0" y="112" width="535" height="20" positionType="Float"/><subreportParameter name="ID_SOLICITUD"><subreportParameterExpression><![CDATA[$F{id_solicitud}]]></subreportParameterExpression></subreportParameter><connectionExpression><![CDATA[$P{REPORT_CONNECTION}]]></connectionExpression><subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "comprobanteEntregaMaterialDetalle.jasper"]]></subreportExpression></subreport>
<staticText><reportElement x="0" y="136" width="535" height="24" positionType="Float" forecolor="#56637A"/><textElement><font size="7.5" isItalic="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[El técnico recibe el material para la orden indicada y se compromete a rendirlo: lo usado queda registrado en la orden y lo que sobre se devuelve al depósito. La orden no se puede finalizar con material sin rendir.]]></text></staticText>
