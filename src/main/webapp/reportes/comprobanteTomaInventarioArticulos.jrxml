<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteTomaInventarioArticulos" language="groovy" pageWidth="535" pageHeight="842" columnWidth="535"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="NoDataSection" isIgnorePagination="true">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_TOMA" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT CASE WHEN a.tipo_articulo = 'R' THEN 'Repuesto' ELSE 'Insumo' END AS tipo,
 COALESCE(r.nombre, i.nombre) || COALESCE(' (' || u.nombre_unidad || ')', '') AS descripcion,
 a.cantidad_sistema, a.cantidad_contada, a.cantidad_contada - a.cantidad_sistema AS diferencia,
 COALESCE(a.costo_unitario, 0) AS costo_unitario,
 (a.cantidad_contada - a.cantidad_sistema) * COALESCE(a.costo_unitario, 0) AS valor
FROM public.tomas_inventario_articulos a
LEFT JOIN public.catalogo_repuestos r ON a.tipo_articulo = 'R' AND r.id_repuesto = a.id_articulo
LEFT JOIN public.catalogo_insumos i ON a.tipo_articulo = 'I' AND i.id_insumo = a.id_articulo
LEFT JOIN public.unidades_medida u ON u.id_unidad = i.id_unidad
WHERE a.id_toma = $P{ID_TOMA}
ORDER BY (a.cantidad_contada = a.cantidad_sistema), a.tipo_articulo DESC, 2]]></queryString>
	<field name="tipo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="cantidad_sistema" class="java.math.BigDecimal"/>
	<field name="cantidad_contada" class="java.math.BigDecimal"/>
	<field name="diferencia" class="java.math.BigDecimal"/>
	<field name="costo_unitario" class="java.math.BigDecimal"/>
	<field name="valor" class="java.math.BigDecimal"/>
	<variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{valor}]]></variableExpression></variable>
	<variable name="CON_DIF" class="java.lang.Integer" calculation="Sum"><variableExpression><![CDATA[$F{diferencia} != null && $F{diferencia}.signum() != 0 ? 1 : 0]]></variableExpression></variable>
	<columnHeader><band height="18">
<staticText><reportElement x="0" y="0" width="55" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Tipo]]></text></staticText><staticText><reportElement x="55" y="0" width="185" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Artículo]]></text></staticText><staticText><reportElement x="240" y="0" width="55" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Sistema]]></text></staticText><staticText><reportElement x="295" y="0" width="55" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Real]]></text></staticText><staticText><reportElement x="350" y="0" width="55" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Diferencia]]></text></staticText><staticText><reportElement x="405" y="0" width="60" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Costo unit.]]></text></staticText><staticText><reportElement x="465" y="0" width="70" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Valor dif.]]></text></staticText>
	</band></columnHeader>
	<detail><band height="16" splitType="Stretch">
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="55" y="0" width="185" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0.##"><reportElement x="240" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad_sistema}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0.##"><reportElement x="295" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad_contada}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="350" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{diferencia} == null ? "" : ($F{diferencia}.signum() > 0 ? "+" : "") + new java.text.DecimalFormat("#,##0.##").format($F{diferencia})]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="405" y="0" width="60" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{costo_unitario}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="465" y="0" width="70" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{valor}]]></textFieldExpression></textField>
	</band></detail>
	<summary><band height="16">
<textField><reportElement x="0" y="0" width="465" height="16"/><box rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$V{CON_DIF} + " artículo(s) con diferencia — Valor neto de la diferencia (Gs.)"]]></textFieldExpression></textField>
<textField pattern="#,##0"><reportElement x="465" y="0" width="70" height="16" mode="Opaque" backcolor="#F3F5F8"/><box rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$V{TOTAL}]]></textFieldExpression></textField>
	</band></summary>
	<noData><band height="18">
<staticText><reportElement x="0" y="0" width="535" height="18" positionType="FixRelativeToTop" forecolor="#56637A"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Sin artículos.]]></text></staticText>
	</band></noData>
</jasperReport>
