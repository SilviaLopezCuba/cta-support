<staticText><reportElement x="465" y="0" width="70" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Subtotal]]></text></staticText>
	</band></columnHeader>
	<detail><band height="16" splitType="Stretch">
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="75" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="75" y="0" width="65" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{marca}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="140" y="0" width="170" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{modelo}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="310" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{condicion}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="365" y="0" width="40" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="405" y="0" width="60" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{costo_unitario}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="465" y="0" width="70" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField>
