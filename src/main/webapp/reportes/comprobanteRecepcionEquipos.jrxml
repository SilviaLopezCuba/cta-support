<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteRecepcionEquipos" language="groovy" pageWidth="535" pageHeight="842" columnWidth="535"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="NoDataSection" isIgnorePagination="true">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_RECEPCION" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT c.nombre_categoria AS categoria, COALESCE(m.nombre_marca, '-') AS marca,
 x.modelo || COALESCE(' — ' || x.especificaciones, '') AS modelo, x.condicion_ingreso AS condicion,
 x.cantidad, x.costo_unitario, x.cantidad * x.costo_unitario AS subtotal
FROM public.recepciones_detalle_equipos x
JOIN public.categorias c ON c.id_categoria = x.id_categoria LEFT JOIN public.marcas m ON m.id_marca = x.id_marca
WHERE x.id_recepcion = $P{ID_RECEPCION} ORDER BY x.id_detalle]]></queryString>
	<field name="categoria" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
	<field name="modelo" class="java.lang.String"/>
	<field name="condicion" class="java.lang.String"/>
	<field name="cantidad" class="java.lang.Integer"/>
	<field name="costo_unitario" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{subtotal}]]></variableExpression></variable>
	<columnHeader><band height="18">
<staticText><reportElement x="0" y="0" width="75" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Categoría]]></text></staticText>
