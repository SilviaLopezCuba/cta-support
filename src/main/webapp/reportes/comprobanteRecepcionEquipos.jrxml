<textField pattern="#,##0"><reportElement x="465" y="0" width="70" height="16" mode="Opaque" backcolor="#F3F5F8"/><box rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$V{TOTAL}]]></textFieldExpression></textField>
	</band></summary>
	<noData><band height="18">
