<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteTomaInventarioEquipos" language="groovy" pageWidth="535" pageHeight="842" columnWidth="535"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="NoDataSection" isIgnorePagination="true">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_TOMA" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT COALESCE(e.codigo_patrimonial, '(sin código)') AS codigo,
 TRIM(COALESCE(c.nombre_categoria, '') || ' ' || COALESCE(m.nombre_marca, '') || ' ' || COALESCE(e.modelo, '')) AS descripcion,
 e.nro_serie, CASE WHEN q.encontrado THEN 'Sí' WHEN NOT q.encontrado THEN 'NO ENCONTRADO' ELSE '-' END AS encontrado, q.observacion
FROM public.tomas_inventario_equipos q JOIN public.equipos e ON e.id_equipo = q.id_equipo
LEFT JOIN public.categorias c ON c.id_categoria = e.id_categoria LEFT JOIN public.marcas m ON m.id_marca = e.id_marca
WHERE q.id_toma = $P{ID_TOMA}
ORDER BY q.encontrado NULLS FIRST, c.nombre_categoria, e.codigo_patrimonial]]></queryString>
	<field name="codigo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="nro_serie" class="java.lang.String"/>
	<field name="encontrado" class="java.lang.String"/>
	<field name="observacion" class="java.lang.String"/>
	<columnHeader><band height="18">
<staticText><reportElement x="0" y="0" width="80" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Código]]></text></staticText><staticText><reportElement x="80" y="0" width="190" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Equipo]]></text></staticText><staticText><reportElement x="270" y="0" width="95" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[N° serie]]></text></staticText><staticText><reportElement x="365" y="0" width="75" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[¿Está?]]></text></staticText><staticText><reportElement x="440" y="0" width="95" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Observación]]></text></staticText>
	</band></columnHeader>
	<detail><band height="16" splitType="Stretch">
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="80" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="80" y="0" width="190" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="270" y="0" width="95" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{nro_serie}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="365" y="0" width="75" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{encontrado}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="440" y="0" width="95" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{observacion}]]></textFieldExpression></textField>
	</band></detail>
	<noData><band height="18">
<staticText><reportElement x="0" y="0" width="535" height="18" positionType="FixRelativeToTop" forecolor="#56637A"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Sin equipos.]]></text></staticText>
	</band></noData>
