<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeSolicitudes" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="SUBTITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT (t.numero_ticket)::text AS numero_ticket,
       (to_char(t.fecha_creacion, 'DD/MM/YYYY HH24:MI'))::text AS fecha,
       (t.tipo_falla)::text AS tipo_falla,
       (t.estado)::text AS estado,
       (CASE t.prioridad WHEN 'Critica' THEN 'Crítica' ELSE t.prioridad END)::text AS prioridad,
       (COALESCE(per.apellido || ', ' || per.nombre, 'N/D'))::text AS solicitante,
       (s.nombre_sala)::text AS nombre_sala,
       (e.codigo_patrimonial)::text AS equipo,
       (CASE WHEN t.fecha_revision IS NOT NULL THEN to_char(t.fecha_revision, 'DD/MM/YYYY HH24:MI') WHEN t.estado IN ('Asignado', 'En Proceso', 'Esperando Repuesto') THEN 'Sin revisar' ELSE '—' END)::text AS revision,
       (CASE WHEN t.fecha_revision IS NOT NULL THEN replace(rtrim(to_char(round((EXTRACT(EPOCH FROM (t.fecha_revision - t.fecha_creacion)) / 3600.0)::numeric, 1), 'FM999999990.99'), '.'), '.', ',') ELSE '' END)::text AS horas
FROM public.ticket t LEFT JOIN public.usuarios u ON t.id_usuario_solicita = u.id_usuario LEFT JOIN public.personas per ON u.id_persona = per.id_persona LEFT JOIN public.roles r ON t.id_rol_solicita = r.id_rol LEFT JOIN public.salas s ON t.id_sala = s.id_sala LEFT JOIN public.equipos e ON t.id_equipo = e.id_equipo LEFT JOIN public.tecnicos tc ON t.id_tecnico_asignado = tc.id_tecnico LEFT JOIN public.usuarios ut ON tc.id_usuario = ut.id_usuario LEFT JOIN public.personas pt ON ut.id_persona = pt.id_persona WHERE t.fecha_creacion::date BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date) AND ($P!{FILTROS})
ORDER BY t.fecha_creacion]]>
	</queryString>
	<field name="numero_ticket" class="java.lang.String"/>
	<field name="fecha" class="java.lang.String"/>
	<field name="tipo_falla" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="prioridad" class="java.lang.String"/>
	<field name="solicitante" class="java.lang.String"/>
	<field name="nombre_sala" class="java.lang.String"/>
	<field name="equipo" class="java.lang.String"/>
	<field name="revision" class="java.lang.String"/>
	<field name="horas" class="java.lang.String"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<pageHeader>
