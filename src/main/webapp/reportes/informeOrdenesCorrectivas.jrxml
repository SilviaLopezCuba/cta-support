<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeOrdenesCorrectivas" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="SUBTITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT (t.numero_ticket)::text AS numero_ticket,
       (t.estado)::text AS estado,
       (CASE t.prioridad WHEN 'Critica' THEN 'Crítica' ELSE t.prioridad END)::text AS prioridad,
       (COALESCE(e.modelo || ' (' || e.codigo_patrimonial || ')', 'N/D'))::text AS equipo,
       (COALESCE(p.apellido || ', ' || p.nombre, 'Sin asignar'))::text AS tecnico,
       (to_char(t.fecha_fin, 'DD/MM/YYYY HH24:MI'))::text AS fecha_fin,
       (round(t.tiempo_resolucion)::int)::text AS tiempo,
       (COALESCE((SELECT string_agg(cs.nombre_servicio || CASE WHEN COALESCE(ts.detalle, '') <> '' THEN ' (' || ts.detalle || ')' ELSE '' END, ', ' ORDER BY ts.id) FROM public.ticket_servicios ts JOIN public.catalogo_servicios cs ON cs.id_servicio = ts.id_servicio WHERE ts.id_ticket = t.id_ticket), '—'))::text AS servicios,
       (COALESCE((SELECT string_agg(COALESCE(cr.nombre, ci.nombre) || ' x' || replace(rtrim(to_char(tr.cantidad, 'FM999999990.99'), '.'), '.', ','), ', ' ORDER BY tr.id) FROM public.ticket_repuesto tr LEFT JOIN public.catalogo_repuestos cr ON cr.id_repuesto = tr.id_repuesto LEFT JOIN public.catalogo_insumos ci ON ci.id_insumo = tr.id_insumo WHERE tr.id_ticket = t.id_ticket), '—'))::text AS material,
       (CASE WHEN bj.numero IS NOT NULL THEN 'No reparable (' || bj.numero || ')' ELSE 'Reparado' END)::text AS resultado
FROM public.ticket t LEFT JOIN public.equipos e ON t.id_equipo = e.id_equipo LEFT JOIN public.tecnicos tc ON t.id_tecnico_asignado = tc.id_tecnico LEFT JOIN public.usuarios u ON tc.id_usuario = u.id_usuario LEFT JOIN public.personas p ON u.id_persona = p.id_persona LEFT JOIN public.salas s ON t.id_sala = s.id_sala LEFT JOIN public.usuarios us ON t.id_usuario_solicita = us.id_usuario LEFT JOIN public.personas ps ON us.id_persona = ps.id_persona LEFT JOIN LATERAL (SELECT mv.numero FROM public.movimientos_equipos mv WHERE mv.tipo = 'BAJA' AND mv.origen = 'Ticket ' || t.numero_ticket ORDER BY mv.id_movimiento DESC LIMIT 1) bj ON true WHERE t.estado IN ('Resuelto','Cerrado') AND t.fecha_fin::date BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date) AND ($P!{FILTROS})
ORDER BY t.fecha_fin]]>
	</queryString>
	<field name="numero_ticket" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="prioridad" class="java.lang.String"/>
	<field name="equipo" class="java.lang.String"/>
	<field name="tecnico" class="java.lang.String"/>
	<field name="fecha_fin" class="java.lang.String"/>
	<field name="tiempo" class="java.lang.String"/>
	<field name="servicios" class="java.lang.String"/>
	<field name="material" class="java.lang.String"/>
	<field name="resultado" class="java.lang.String"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
