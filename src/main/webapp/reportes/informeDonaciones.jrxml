<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeDonaciones" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT d.id_donacion, d.nro_comprobante, d.fecha_donacion, n.nombre,
 (SELECT COUNT(*) FROM public.donaciones_detalle x WHERE x.id_donacion = d.id_donacion) AS items,
 (SELECT COALESCE(SUM(x.cantidad), 0) FROM public.donaciones_detalle x WHERE x.id_donacion = d.id_donacion) AS unidades
FROM public.donaciones d
JOIN public.donantes n ON d.id_donante = n.id_donante
WHERE d.estado = 'Registrada' AND d.fecha_donacion BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date)
ORDER BY d.fecha_donacion, d.id_donacion]]>
	</queryString>
	<field name="id_donacion" class="java.lang.Integer"/>
	<field name="nro_comprobante" class="java.lang.String"/>
	<field name="fecha_donacion" class="java.sql.Date"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="items" class="java.lang.Long"/>
	<field name="unidades" class="java.math.BigDecimal"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="totUnidades" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{unidades} == null ? 0 : $F{unidades}]]></variableExpression>
	</variable>
	<variable name="totArticulos" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{items} == null ? 0L : $F{items}]]></variableExpression>
	</variable>
