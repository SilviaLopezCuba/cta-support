			<rectangle><reportElement stretchType="RelativeToBandHeight" x="0" y="0" width="786" height="18" forecolor="#F3F5F8" backcolor="#F3F5F8"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="50" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{id_donacion}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="50" y="0" width="130" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{nro_comprobante} == null || $F{nro_comprobante}.trim().isEmpty() ? "—" : $F{nro_comprobante}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="180" y="0" width="90" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{fecha_donacion} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_donacion}) : ""]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="270" y="0" width="316" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{nombre} == null || $F{nombre}.trim().isEmpty() ? "—" : $F{nombre}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="586" y="0" width="90" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{items}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="676" y="0" width="110" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{unidades} == null ? "—" : new java.text.DecimalFormat("#,##0", java.text.DecimalFormatSymbols.getInstance(new java.util.Locale("es", "PY"))).format($F{unidades})]]></textFieldExpression></textField>
