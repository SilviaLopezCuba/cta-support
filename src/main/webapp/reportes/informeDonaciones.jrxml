			<staticText><reportElement x="586" y="0" width="90" height="20" forecolor="#FFFFFF"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Artículos]]></text></staticText>
			<staticText><reportElement x="676" y="0" width="110" height="20" forecolor="#FFFFFF"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Unidades]]></text></staticText>
