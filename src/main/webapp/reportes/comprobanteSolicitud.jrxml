<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteSolicitud" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="30">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_TICKET" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<queryString><![CDATA[SELECT t.id_ticket, t.numero_ticket, t.fecha_creacion, t.estado, t.prioridad, t.tipo_falla, t.descripcion,
 ps.apellido || ', ' || ps.nombre AS solicitante, r.nombre_rol,
 COALESCE(d.nombre_departamento, '-') AS departamento, s.nombre_sala,
 COALESCE(e.codigo_patrimonial, 'Sin código') || ' - ' || e.modelo AS equipo,
 COALESCE(c.nombre_categoria, '-') || COALESCE(' / ' || m.nombre_marca, '') AS categoria,
 pt.apellido || ', ' || pt.nombre AS tecnico
FROM public.ticket t
LEFT JOIN public.usuarios us ON us.id_usuario = t.id_usuario_solicita LEFT JOIN public.personas ps ON ps.id_persona = us.id_persona
LEFT JOIN public.roles r ON r.id_rol = us.id_rol
LEFT JOIN public.salas s ON s.id_sala = t.id_sala LEFT JOIN public.departamentos d ON d.id_departamento = s.id_departamento
LEFT JOIN public.equipos e ON e.id_equipo = t.id_equipo LEFT JOIN public.categorias c ON c.id_categoria = e.id_categoria
LEFT JOIN public.marcas m ON m.id_marca = e.id_marca
LEFT JOIN public.tecnicos tc ON tc.id_tecnico = t.id_tecnico_asignado LEFT JOIN public.usuarios ut ON ut.id_usuario = tc.id_usuario
LEFT JOIN public.personas pt ON pt.id_persona = ut.id_persona
WHERE t.id_ticket = $P{ID_TICKET}]]></queryString>
	<field name="id_ticket" class="java.lang.Integer"/>
	<field name="numero_ticket" class="java.lang.String"/>
	<field name="fecha_creacion" class="java.sql.Timestamp"/>
	<field name="estado" class="java.lang.String"/>
	<field name="prioridad" class="java.lang.String"/>
	<field name="tipo_falla" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="solicitante" class="java.lang.String"/>
	<field name="nombre_rol" class="java.lang.String"/>
	<field name="departamento" class="java.lang.String"/>
	<field name="nombre_sala" class="java.lang.String"/>
	<field name="equipo" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="tecnico" class="java.lang.String"/>
	<title>
		<band height="68" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank"><reportElement x="0" y="2" width="92" height="46"/><imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression></image>
			<staticText><reportElement x="104" y="4" width="261" height="24" forecolor="#14284B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Comprobante de Solicitud]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="104" y="28" width="261" height="16" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Ticket N\u00b0 " + ($F{numero_ticket} == null ? "#" + $F{id_ticket} : $F{numero_ticket}) + " \u2014 " + ($F{tipo_falla} == null ? "" : $F{tipo_falla})]]></textFieldExpression></textField>
			<textField><reportElement x="365" y="10" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="365" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{USUARIO_IMPRESION} == null ? "" : "Por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression></textField>
			<rectangle><reportElement x="0" y="54" width="178" height="3" forecolor="#B01E35" backcolor="#B01E35"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="178" y="54" width="178" height="3" forecolor="#AAB4C0" backcolor="#AAB4C0"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="356" y="54" width="179" height="3" forecolor="#1F5BA8" backcolor="#1F5BA8"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		</band>
	</title>
