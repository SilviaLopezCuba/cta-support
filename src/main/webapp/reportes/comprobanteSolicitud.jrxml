<frame><reportElement x="0" y="32" width="535" height="14" positionType="Float"/><staticText><reportElement x="0" y="0" width="105" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject" forecolor="#56637A" mode="Opaque" backcolor="#F3F5F8"/><box leftPadding="6" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Estado actual]]></text></staticText><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="105" y="0" width="162" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{estado} != null && !$F{estado}.toString().trim().isEmpty()) ? $F{estado}.toString() : "-"]]></textFieldExpression></textField><staticText><reportElement x="267" y="0" width="105" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject" forecolor="#56637A" mode="Opaque" backcolor="#F3F5F8"/><box leftPadding="6" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Técnico asignado]]></text></staticText><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="372" y="0" width="163" height="14" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" vertical