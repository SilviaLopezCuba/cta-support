			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="6" y="22" width="774" height="14" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$V{totalRegistros} == 0 ? null : "Por estado:  " + ($V{estGenerada} > 0 ? "Generada: " + $V{estGenerada} + "     " : "") + ($V{estEnviada} > 0 ? "Enviada: " + $V{estEnviada} + "     " : "") + ($V{estRecibida} > 0 ? "Recibida: " + $V{estRecibida} + "     " : "") + ($V{estCancelada} > 0 ? "Cancelada: " + $V{estCancelada} + "     " : "")]]></textFieldExpression></textField>
