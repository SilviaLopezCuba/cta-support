<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeInventario" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT s.id_solicitud, s.numero_solicitud, s.fecha_solicitud, s.estado,
 COALESCE(p.apellido || ', ' || p.nombre, '-') AS solicitante,
 (SELECT COUNT(*) FROM public.solicitudes_compra_detalle d WHERE d.id_solicitud = s.id_solicitud) AS items
FROM public.solicitudes_compra s
LEFT JOIN public.usuarios u ON s.id_usuario_solicita = u.id_usuario
LEFT JOIN public.personas p ON u.id_persona = p.id_persona
WHERE s.fecha_solicitud BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date)
  AND ($P!{FILTROS})
ORDER BY s.fecha_solicitud, s.id_solicitud]]>
	</queryString>
	<field name="id_solicitud" class="java.lang.Integer"/>
	<field name="numero_solicitud" class="java.lang.String"/>
	<field name="fecha_solicitud" class="java.sql.Timestamp"/>
	<field name="estado" class="java.lang.String"/>
	<field name="solicitante" class="java.lang.String"/>
	<field name="items" class="java.lang.Long"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="estGenerada" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Generada".equals($F{estado}) ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="estEnviada" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Enviada".equals($F{estado}) ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="estRecibida" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Recibida".equals($F{estado}) ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="estCancelada" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA["Cancelada".equals($F{estado}) ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<pageHeader>
