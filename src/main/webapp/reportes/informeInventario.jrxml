			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="50" y="0" width="140" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{numero_solicitud} == null || $F{numero_solicitud}.trim().isEmpty() ? "—" : $F{numero_solicitud}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="190" y="0" width="100" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{fecha_solicitud} != null ? new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format($F{fecha_solicitud}) : ""]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="290" y="0" width="286" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{solicitante} == null || $F{solicitante}.trim().isEmpty() ? "—" : $F{solicitante}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="576" y="0" width="110" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{estado} == null || $F{estado}.trim().isEmpty() ? "—" : $F{estado}]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="686" y="0" width="100" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="6" bottomPadding="3" rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{items}]]></textFieldExpression></textField>
