			<staticText><reportElement x="50" y="0" width="140" height="20" forecolor="#FFFFFF"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[N° solicitud]]></text></staticText>
			<staticText><reportElement x="190" y="0" width="100" height="20" forecolor="#FFFFFF"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Fecha]]></text></staticText>
			<staticText><reportElement x="290" y="0" width="286" height="20" forecolor="#FFFFFF"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Solicitante]]></text></staticText>
			<staticText><reportElement x="576" y="0" width="110" height="20" forecolor="#FFFFFF"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Estado]]></text></staticText>
			<staticText><reportElement x="686" y="0" width="100" height="20" forecolor="#FFFFFF"/><box leftPadding="6" rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8.5" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Artículos]]></text></staticText>
