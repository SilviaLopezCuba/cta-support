<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteEntregaMaterialDetalle" language="groovy" pageWidth="535" pageHeight="842" columnWidth="535"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="NoDataSection" isIgnorePagination="true">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_SOLICITUD" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT CASE WHEN d.tipo_articulo = 'R' THEN 'Repuesto' ELSE 'Insumo' END AS tipo,
 COALESCE(r.nombre, i.nombre) || COALESCE(' (' || u.nombre_unidad || ')', '') AS descripcion,
 d.cantidad_solicitada, d.cantidad_entregada, COALESCE(d.costo_unitario, 0) AS costo_unitario,
 d.cantidad_entregada * COALESCE(d.costo_unitario, 0) AS subtotal
FROM public.solicitudes_material_detalle d
LEFT JOIN public.catalogo_repuestos r ON d.tipo_articulo = 'R' AND r.id_repuesto = d.id_articulo
LEFT JOIN public.catalogo_insumos i ON d.tipo_articulo = 'I' AND i.id_insumo = d.id_articulo
LEFT JOIN public.unidades_medida u ON u.id_unidad = i.id_unidad
WHERE d.id_solicitud = $P{ID_SOLICITUD} ORDER BY d.id_detalle]]></queryString>
	<field name="tipo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="cantidad_solicitada" class="java.math.BigDecimal"/>
	<field name="cantidad_entregada" class="java.math.BigDecimal"/>
	<field name="costo_unitario" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{subtotal}]]></variableExpression></variable>
	<columnHeader><band height="18">
<staticText><reportElement x="0" y="0" width="65" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Tipo]]></text></staticText>
<staticText><reportElement x="65" y="0" width="200" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Descripción]]></text></staticText>
<staticText><reportElement x="265" y="0" width="55" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Pedido]]></text></staticText>
<staticText><reportElement x="320" y="0" width="60" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Entregado]]></text></staticText>
<staticText><reportElement x="380" y="0" width="70" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Costo unit.]]></text></staticText>
<staticText><reportElement x="450" y="0" width="85" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Subtotal]]></text></staticText>
	</band></columnHeader>
	<detail><band height="16" splitType="Stretch">
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="65" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="65" y="0" width="200" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0.##"><reportElement x="265" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad_solicitada}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0.##"><reportElement x="320" y="0" width="60" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad_entregada}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="380" y="0" width="70" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{costo_unitario}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="450" y="0" width="85" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField>
	</band></detail>
	<summary><band height="16">
<staticText><reportElement x="0" y="0" width="450" height="16"/><box rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Valor entregado (Gs.)]]></text></staticText>
