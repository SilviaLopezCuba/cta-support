ement textAlignment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[($F{estado} != null && !$F{estado}.toString().trim().isEmpty()) ? $F{estado}.toString() : "-"]]></textFieldExpression></textField></frame>
