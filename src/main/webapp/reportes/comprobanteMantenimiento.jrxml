<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteMantenimiento" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="30">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_MANTENIMIENTO" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<queryString><![CDATA[SELECT m.id_mantenimiento, m.numero_mantenimiento, m.estado, m.fecha_programada, m.fecha_inicio, m.fecha_fin, m.observaciones,
 s.nombre_sala, s.ubicacion_piso, s.capacidad,
 pej.apellido || ', ' || pej.nombre AS tecnico_ejecuta, ppr.apellido || ', ' || ppr.nombre AS tecnico_programa,
 CASE WHEN m.fecha_inicio IS NOT NULL AND m.fecha_fin IS NOT NULL THEN CAST(EXTRACT(EPOCH FROM (m.fecha_fin - m.fecha_inicio)) / 60 AS integer) END AS duracion_min,
 (SELECT COUNT(*) FROM public.mantenimientos_preventivos_detalle dm WHERE dm.id_mantenimiento = m.id_mantenimiento) AS total_equipos,
 (SELECT COUNT(*) FROM public.mantenimientos_preventivos_detalle dm WHERE dm.id_mantenimiento = m.id_mantenimiento AND dm.realizado) AS equipos_realizados
FROM public.mantenimientos_preventivos m
LEFT JOIN public.salas s ON m.id_sala = s.id_sala
LEFT JOIN public.tecnicos tej ON m.id_tecnico_ejecuta = tej.id_tecnico LEFT JOIN public.usuarios uej ON tej.id_usuario = uej.id_usuario LEFT JOIN public.personas pej ON uej.id_persona = pej.id_persona
LEFT JOIN public.tecnicos tpr ON m.id_tecnico = tpr.id_tecnico LEFT JOIN public.usuarios upr ON tpr.id_usuario = upr.id_usuario LEFT JOIN public.personas ppr ON upr.id_persona = ppr.id_persona
WHERE m.id_mantenimiento = $P{ID_MANTENIMIENTO}]]></queryString>
	<field name="id_mantenimiento" class="java.lang.Integer"/>
	<field name="numero_mantenimiento" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observaciones" class="java.lang.String"/>
	<field name="nombre_sala" class="java.lang.String"/>
	<field name="ubicacion_piso" class="java.lang.String"/>
	<field name="tecnico_ejecuta" class="java.lang.String"/>
	<field name="tecnico_programa" class="java.lang.String"/>
	<field name="fecha_programada" class="java.sql.Date"/>
	<field name="fecha_inicio" class="java.sql.Timestamp"/>
	<field name="fecha_fin" class="java.sql.Timestamp"/>
	<field name="capacidad" class="java.lang.Integer"/>
	<field name="duracion_min" class="java.lang.Integer"/>
	<field name="total_equipos" class="java.lang.Long"/>
	<field name="equipos_realizados" class="java.lang.Long"/>
	<title>
		<band height="68" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank"><reportElement x="0" y="2" width="92" height="46"/><imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression></image>
			<staticText><reportElement x="104" y="4" width="261" height="24" forecolor="#14284B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="11.5" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Comprobante de Mantenimiento Preventivo]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="104" y="28" width="261" height="16" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["N\u00b0 " + $F{numero_mantenimiento} + " \u2014 Estado: " + $F{estado}]]></textFieldExpression></textField>
			<textField><reportElement x="365" y="10" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="365" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{USUARIO_IMPRESION} == null ? "" : "Por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression></textField>
			<rectangle><reportElement x="0" y="54" width="178" height="3" forecolor="#B01E35" backcolor="#B01E35"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="178" y="54" width="178" height="3" forecolor="#AAB4C0" backcolor="#AAB4C0"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="356" y="54" width="179" height="3" forecolor="#1F5BA8" backcolor="#1F5BA8"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		</band>
	</title>
	<detail><band height="234" splitType="Stretch">
