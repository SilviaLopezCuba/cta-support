nment="Left" verticalAlignment="Middle"><font size="9" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{equipos_realizados} + " de " + $F{total_equipos}]]></textFieldExpression></textField></frame>
