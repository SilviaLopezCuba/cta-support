<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="reportePatrimonio" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="30" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_SALA" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<queryString><![CDATA[SELECT CASE WHEN s.es_deposito THEN '0' ELSE '1' END || COALESCE(d.nombre_departamento, '~') || '|' || COALESCE(s.nombre_sala, '') AS orden_ubic,
 CASE WHEN s.es_deposito THEN 'Depósito' ELSE COALESCE(d.nombre_departamento, 'Sin departamento') || ' — ' || s.nombre_sala END AS ubicacion,
 COALESCE(e.codigo_patrimonial, '(sin código)') AS codigo,
 TRIM(COALESCE(c.nombre_categoria, '') || ' ' || COALESCE(m.nombre_marca, '') || ' ' || COALESCE(e.modelo, '')) AS descripcion,
 e.condicion_ingreso, CASE WHEN e.estado = 'Activo' THEN 'Activo' ELSE 'Inactivo (' || COALESCE(mi.nombre_motivo, '') || ')' END AS estado,
 e.fecha_ingreso, e.costo, c.vida_util_anios,
 ROUND(e.costo * GREATEST(0, 1 - ((CURRENT_DATE - e.fecha_ingreso) / 365.25) / NULLIF(c.vida_util_anios, 0)))::numeric(14,2) AS valor_actual
FROM public.equipos e
JOIN public.salas s ON s.id_sala = e.id_sala
LEFT JOIN public.departamentos d ON d.id_departamento = s.id_departamento
LEFT JOIN public.categorias c ON c.id_categoria = e.id_categoria
LEFT JOIN public.marcas m ON m.id_marca = e.id_marca
LEFT JOIN public.motivos_inactivo mi ON mi.id_motivo = e.id_motivo_inactivo
WHERE (e.estado = 'Activo' OR NOT COALESCE(mi.descuenta, false))
  AND ($P{ID_SALA} IS NULL OR e.id_sala = $P{ID_SALA})
ORDER BY 1, c.nombre_categoria, e.codigo_patrimonial NULLS LAST, e.id_equipo]]></queryString>
	<field name="orden_ubic" class="java.lang.String"/>
	<field name="ubicacion" class="java.lang.String"/>
	<field name="codigo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="condicion_ingreso" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="fecha_ingreso" class="java.sql.Date"/>
	<field name="costo" class="java.math.BigDecimal"/>
	<field name="vida_util_anios" class="java.lang.Integer"/>
	<field name="valor_actual" class="java.math.BigDecimal"/>
	<variable name="G_COSTO" class="java.math.BigDecimal" resetType="Group" resetGroup="ubic" calculation="Sum"><variableExpression><![CDATA[$F{costo}]]></variableExpression></variable>
	<variable name="G_VALOR" class="java.math.BigDecimal" resetType="Group" resetGroup="ubic" calculation="Sum"><variableExpression><![CDATA[($F{valor_actual} == null ? $F{costo} : $F{valor_actual})]]></variableExpression></variable>
	<variable name="T_COSTO" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{costo}]]></variableExpression></variable>
	<variable name="T_VALOR" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[($F{valor_actual} == null ? $F{costo} : $F{valor_actual})]]></variableExpression></variable>
	<group name="ubic">
		<groupExpression><![CDATA[$F{orden_ubic}]]></groupExpression>
		<groupHeader><band height="40">
<textField><reportElement x="0" y="4" width="535" height="16" forecolor="#14284B"/><box bottomPadding="1"><bottomPen lineWidth="1.0" lineColor="#14284B"/></box><textElement verticalAlignment="Middle"><font size="10" isBold="true" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{ubicacion}]]></textFieldExpression></textField>
<frame><reportElement x="0" y="22" width="535" height="18"/><staticText><reportElement x="0" y="0" width="62" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Código]]></text></staticText><staticText><reportElement x="62" y="0" width="150" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Equipo]]></text></staticText><staticText><reportElement x="212" y="0" width="50" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Condición]]></text></staticText><staticText><reportElement x="262" y="0" width="63" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Estado]]></text></staticText><staticText><reportElement x="325" y="0" width="50" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Ingreso]]></text></staticText><staticText><reportElement x="375" y="0" width="55" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Costo (Gs.)]]></text></staticText><staticText><reportElement x="430" y="0" width="45" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Vida útil]]></text></staticText><staticText><reportElement x="475" y="0" width="60" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Valor actual]]></text></staticText></frame>
		</band></groupHeader>
		<groupFooter><band height="22">
<textField><reportElement x="0" y="0" width="375" height="16" mode="Opaque" backcolor="#F3F5F8"/><box rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Subtotal " + $F{ubicacion} + " (" + $V{ubic_COUNT} + " equipos)"]]></textFieldExpression></textField>
<textField pattern="#,##0"><reportElement x="375" y="0" width="55" height="16" mode="Opaque" backcolor="#F3F5F8"/><box rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$V{G_COSTO}]]></textFieldExpression></textField>
<staticText><reportElement x="430" y="0" width="45" height="16" mode="Opaque" backcolor="#F3F5F8"/><text><![CDATA[]]></text></staticText>
<textField pattern="#,##0"><reportElement x="475" y="0" width="60" height="16" mode="Opaque" backcolor="#F3F5F8"/><box rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$V{G_VALOR}]]></textFieldExpression></textField>
		</band></groupFooter>
	</group>
	<title>
		<band height="68" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank"><reportElement x="0" y="2" width="92" height="46"/><imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression></image>
			<staticText><reportElement x="104" y="4" width="261" height="24" forecolor="#14284B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Patrimonio de Equipos]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="104" y="28" width="261" height="16" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Valor actual con depreciaci\u00f3n lineal, por ubicaci\u00f3n" + ($P{ID_SALA} == null ? "" : " (una sala)")]]></textFieldExpression></textField>
			<textField><reportElement x="365" y="10" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="365" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{USUARIO_IMPRESION} == null ? "" : "Por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression></textField>
			<rectangle><reportElement x="0" y="54" width="178" height="3" forecolor="#B01E35" backcolor="#B01E35"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="178" y="54" width="178" height="3" forecolor="#AAB4C0" backcolor="#AAB4C0"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="356" y="54" width="179" height="3" forecolor="#1F5BA8" backcolor="#1F5BA8"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		</band>
	</title>
	<detail><band height="16" splitType="Stretch">
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="62" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="62" y="0" width="150" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="212" y="0" width="50" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{condicion_ingreso}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="262" y="0" width="63" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="325" y="0" width="50" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{fecha_ingreso} == null ? "-" : new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_ingreso})]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="375" y="0" width="55" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{costo}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="430" y="0" width="45" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{vida_util_anios} == null ? "-" : $F{vida_util_anios} + " a."]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="475" y="0" width="60" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{valor_actual} == null ? $F{costo} : $F{valor_actual}]]></textFieldExpression></textField>
	</band></detail>
	<pageFooter>
		<band height="22" splitType="Stretch">
			<line><reportElement x="0" y="4" width="535" height="1" forecolor="#DDE2EA"/><graphicElement><pen lineWidth="0.5" lineColor="#DDE2EA"/></graphicElement></line>
			<staticText><reportElement x="0" y="8" width="415" height="12" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7.5" isBold="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Patrimonio de Equipos — CTA Support]]></text></staticText>
			<textField><reportElement x="415" y="8" width="95" height="12" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="7.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression></textField>
			<textField evaluationTime="Report"><reportElement x="510" y="8" width="25" height="12" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="7.5" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
