<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteRecepcionArticulos" language="groovy" pageWidth="535" pageHeight="842" columnWidth="535"
              leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenNoDataType="NoDataSection" isIgnorePagination="true">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_RECEPCION" class="java.lang.Integer"/>
	<queryString><![CDATA[SELECT CASE WHEN x.id_repuesto IS NOT NULL THEN 'Repuesto' ELSE 'Insumo' END AS tipo,
 COALESCE(r.nombre, i.nombre) || COALESCE(' (' || u.nombre_unidad || ')', '') AS descripcion,
 x.cantidad, x.costo_unitario, x.cantidad * x.costo_unitario AS subtotal
FROM public.recepciones_detalle_articulos x
LEFT JOIN public.catalogo_repuestos r ON r.id_repuesto = x.id_repuesto
LEFT JOIN public.catalogo_insumos i ON i.id_insumo = x.id_insumo
LEFT JOIN public.unidades_medida u ON u.id_unidad = i.id_unidad
WHERE x.id_recepcion = $P{ID_RECEPCION} ORDER BY x.id_detalle]]></queryString>
	<field name="tipo" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="cantidad" class="java.math.BigDecimal"/>
	<field name="costo_unitario" class="java.math.BigDecimal"/>
	<field name="subtotal" class="java.math.BigDecimal"/>
	<variable name="TOTAL" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{subtotal}]]></variableExpression></variable>
	<columnHeader><band height="18">
<staticText><reportElement x="0" y="0" width="70" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Tipo]]></text></staticText>
<staticText><reportElement x="70" y="0" width="235" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Descripción]]></text></staticText>
<staticText><reportElement x="305" y="0" width="60" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Cant.]]></text></staticText>
<staticText><reportElement x="365" y="0" width="80" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Costo unit.]]></text></staticText>
<staticText><reportElement x="445" y="0" width="90" height="18" positionType="FixRelativeToTop" forecolor="#FFFFFF" mode="Opaque" backcolor="#14284B"/><box leftPadding="4" rightPadding="4"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Subtotal]]></text></staticText>
	</band></columnHeader>
	<detail><band height="16" splitType="Stretch">
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="70" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="70" y="0" width="235" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0.##"><reportElement x="305" y="0" width="60" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="365" y="0" width="80" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{costo_unitario}]]></textFieldExpression></textField>
<textField textAdjust="StretchHeight" isBlankWhenNull="true" pattern="#,##0"><reportElement x="445" y="0" width="90" height="16" positionType="FixRelativeToTop" stretchType="RelativeToTallestObject"/><box topPadding="2" leftPadding="4" bottomPadding="2" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{subtotal}]]></textFieldExpression></textField>
	</band></detail>
	<summary><band height="16">
<staticText><reportElement x="0" y="0" width="445" height="16"/><box rightPadding="6"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Total (Gs.)]]></text></staticText>
<textField pattern="#,##0"><reportElement x="445" y="0" width="90" height="16" mode="Opaque" backcolor="#F3F5F8"/><box rightPadding="4"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$V{TOTAL}]]></textFieldExpression></textField>
	</band></summary>
	<noData><band height="18">
<staticText><reportElement x="0" y="0" width="535" height="18" positionType="FixRelativeToTop" forecolor="#56637A"/><box topPadding="2" leftPadding="6" bottomPadding="2" rightPadding="6"><bottomPen lineWidth="0.5" lineColor="#DDE2EA"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false" isItalic="false" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Esta recepción no incluye repuestos ni insumos.]]></text></staticText>
	</band></noData>
</jasperReport>
