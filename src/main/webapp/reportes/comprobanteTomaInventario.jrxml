<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="comprobanteTomaInventario" language="groovy" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="24" bottomMargin="30">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="9" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="ID_TOMA" class="java.lang.Integer"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="USUARIO_IMPRESION" class="java.lang.String"/>
	<queryString><![CDATA[SELECT t.id_toma, t.numero_toma, t.tipo_toma, t.estado, t.observacion, t.observacion_resolucion, t.fecha_creacion, t.fecha_envio, t.fecha_resolucion,
 CASE WHEN t.tipo_toma = 'ARTICULOS' THEN 'Repuestos e insumos del depósito' ELSE 'Equipos de ' || s.nombre_sala END AS alcance,
 pc.apellido || ', ' || pc.nombre AS conto,
 pr.apellido || ', ' || pr.nombre AS resolvio
FROM public.tomas_inventario t
LEFT JOIN public.salas s ON s.id_sala = t.id_sala
LEFT JOIN public.usuarios uc ON uc.id_usuario = t.id_usuario_crea LEFT JOIN public.personas pc ON pc.id_persona = uc.id_persona
LEFT JOIN public.usuarios ur ON ur.id_usuario = t.id_usuario_resuelve LEFT JOIN public.personas pr ON pr.id_persona = ur.id_persona
WHERE t.id_toma = $P{ID_TOMA}]]></queryString>
	<field name="id_toma" class="java.lang.Integer"/>
	<field name="numero_toma" class="java.lang.String"/>
	<field name="tipo_toma" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="observacion" class="java.lang.String"/>
	<field name="observacion_resolucion" class="java.lang.String"/>
	<field name="fecha_creacion" class="java.sql.Timestamp"/>
	<field name="fecha_envio" class="java.sql.Timestamp"/>
	<field name="fecha_resolucion" class="java.sql.Timestamp"/>
	<field name="alcance" class="java.lang.String"/>
	<field name="conto" class="java.lang.String"/>
	<field name="resolvio" class="java.lang.String"/>
	<title>
		<band height="68" splitType="Stretch">
			<image scaleImage="RetainShape" hAlign="Left" vAlign="Middle" onErrorType="Blank"><reportElement x="0" y="2" width="92" height="46"/><imageExpression><![CDATA[$P{LOGO_PATH}]]></imageExpression></image>
			<staticText><reportElement x="104" y="4" width="261" height="24" forecolor="#14284B"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="16" isBold="true" pdfEncoding="Cp1252"/></textElement><text><![CDATA[Ajuste de Inventario]]></text></staticText>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="104" y="28" width="261" height="16" forecolor="#56637A"/><textElement verticalAlignment="Middle"><font fontName="SansSerif" size="9" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["N\u00b0 " + $F{numero_toma} + " \u2014 " + $F{alcance}]]></textFieldExpression></textField>
			<textField><reportElement x="365" y="10" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA["Emitido el " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
			<textField textAdjust="ScaleFont" isBlankWhenNull="true"><reportElement x="365" y="24" width="170" height="14" forecolor="#56637A"/><textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$P{USUARIO_IMPRESION} == null ? "" : "Por: " + $P{USUARIO_IMPRESION}]]></textFieldExpression></textField>
			<rectangle><reportElement x="0" y="54" width="178" height="3" forecolor="#B01E35" backcolor="#B01E35"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="178" y="54" width="178" height="3" forecolor="#AAB4C0" backcolor="#AAB4C0"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
			<rectangle><reportElement x="356" y="54" width="179" height="3" forecolor="#1F5BA8" backcolor="#1F5BA8"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
		</band>
	</title>
	<detail><band height="148" splitType="Stretch">
