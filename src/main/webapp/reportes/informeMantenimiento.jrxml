<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeMantenimiento" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="SUBTITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT (m.numero_mantenimiento)::text AS numero,
       (to_char(m.fecha_programada, 'DD/MM/YYYY'))::text AS fecha_programada,
       (m.estado)::text AS estado,
       (s.nombre_sala)::text AS nombre_sala,
       (COALESCE(p.apellido || ', ' || p.nombre, 'Sin asignar'))::text AS tecnico,
       (to_char(m.fecha_fin, 'DD/MM/YYYY'))::text AS fecha_fin,
       (COALESCE(m.observacion_inicial, '—'))::text AS obs_inicial,
       (COALESCE(NULLIF(concat_ws(', ', CASE WHEN rm.c_ok > 0 THEN 'OK: ' || rm.c_ok END, CASE WHEN rm.c_rep > 0 THEN 'Con repuesto: ' || rm.c_rep END, CASE WHEN rm.c_nr > 0 THEN 'No reparables: ' || rm.c_nr END, CASE WHEN rm.c_der > 0 THEN 'A ticket: ' || rm.c_der END), ''), '—'))::text AS resultados
FROM public.mantenimientos_preventivos m LEFT JOIN public.salas s ON m.id_sala = s.id_sala LEFT JOIN public.tecnicos t ON m.id_tecnico_ejecuta = t.id_tecnico LEFT JOIN public.usuarios u ON t.id_usuario = u.id_usuario LEFT JOIN public.personas p ON u.id_persona = p.id_persona LEFT JOIN LATERAL (SELECT count(*) FILTER (WHERE dd.resultado IN ('OK', 'Reparado')) AS c_ok, count(*) FILTER (WHERE dd.resultado = 'Requirió repuesto') AS c_rep, count(*) FILTER (WHERE dd.resultado = 'No reparable') AS c_nr, count(*) FILTER (WHERE dd.resultado = 'Derivado a ticket') AS c_der FROM public.mantenimientos_preventivos_detalle dd WHERE dd.id_mantenimiento = m.id_mantenimiento) rm ON true WHERE m.fecha_programada BETWEEN CAST($P{DESDE} AS date) AND CAST($P{HASTA} AS date) AND ($P!{FILTROS})
ORDER BY m.fecha_programada]]>
	</queryString>
	<field name="numero" class="java.lang.String"/>
	<field name="fecha_programada" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="nombre_sala" class="java.lang.String"/>
	<field name="tecnico" class="java.lang.String"/>
	<field name="fecha_fin" class="java.lang.String"/>
	<field name="obs_inicial" class="java.lang.String"/>
	<field name="resultados" class="java.lang.String"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
