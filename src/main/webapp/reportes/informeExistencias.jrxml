<?xml version="1.0" encoding="UTF-8"?>
<!-- Generado con el estilo unificado de CTA Support. Colores: tinta #14284B, rojo #B01E35, plata #AAB4C0, azul #1F5BA8. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="informeExistencias" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="786" leftMargin="28" rightMargin="28" topMargin="24" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
	<style name="base" isDefault="true" fontName="SansSerif" fontSize="8.5" forecolor="#1E2B45" pdfEncoding="Cp1252"/>
	<parameter name="DESDE" class="java.lang.String"/>
	<parameter name="HASTA" class="java.lang.String"/>
	<parameter name="USUARIO_GENERA" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="RESUMEN" class="java.lang.String"/>
	<parameter name="SUBTITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String">
		<defaultValueExpression><![CDATA["1=1"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT (a.tipo)::text AS tipo,
       (a.nombre)::text AS nombre,
       (a.grupo)::text AS grupo,
       (replace(rtrim(to_char(a.stock, 'FM999999990.99'), '.'), '.', ','))::text AS stock,
       (replace(rtrim(to_char(a.minimo, 'FM999999990.99'), '.'), '.', ','))::text AS minimo,
       (replace(rtrim(to_char(a.danado, 'FM999999990.99'), '.'), '.', ','))::text AS danado,
       (CASE WHEN a.stock <= 0 THEN 'Sin stock' WHEN a.minimo > 0 AND a.stock < a.minimo THEN 'Bajo mínimo' ELSE 'Normal' END)::text AS situacion,
       (replace(to_char(round(a.costo), 'FM999,999,999,990'), ',', '.'))::text AS costo,
       (replace(to_char(round(a.stock * a.costo), 'FM999,999,999,990'), ',', '.'))::text AS valor
FROM (SELECT 'Repuesto'::text AS tipo, r.nombre, COALESCE(cat.nombre_categoria, '—') AS grupo, r.stock::numeric AS stock, COALESCE(r.stock_minimo, 0)::numeric AS minimo, COALESCE(r.stock_danado, 0) AS danado, COALESCE(r.ultimo_costo, 0) AS costo FROM public.catalogo_repuestos r LEFT JOIN public.categorias cat ON cat.id_categoria = r.id_categoria UNION ALL SELECT 'Insumo', i.nombre, COALESCE(um.nombre_unidad, '—'), COALESCE(i.stock, 0), COALESCE(i.stock_minimo, 0), COALESCE(i.stock_danado, 0), COALESCE(i.ultimo_costo, 0) FROM public.catalogo_insumos i LEFT JOIN public.unidades_medida um ON um.id_unidad = i.id_unidad) a WHERE CAST($P{DESDE} AS date) IS NOT NULL AND CAST($P{HASTA} AS date) IS NOT NULL
  AND ($P!{FILTROS})
ORDER BY a.tipo DESC, a.nombre]]>
	</queryString>
	<field name="tipo" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="grupo" class="java.lang.String"/>
	<field name="stock" class="java.lang.String"/>
	<field name="minimo" class="java.lang.String"/>
	<field name="danado" class="java.lang.String"/>
	<field name="situacion" class="java.lang.String"/>
	<field name="costo" class="java.lang.String"/>
	<field name="valor" class="java.lang.String"/>
	<variable name="totalRegistros" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
