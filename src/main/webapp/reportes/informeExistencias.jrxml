			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="60" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="5" bottomPadding="3" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{tipo} == null || $F{tipo}.toString().trim().isEmpty() ? "—" : $F{tipo}.toString()]]></textFieldExpression></textField>
			<textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="60" y="0" width="220" height="18" stretchType="RelativeToTallestObject"/><box topPadding="3" leftPadding="5" bottomPadding="3" rightPadding="5"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8" isBold="false" pdfEncoding="Cp1252"/></textElement><textFieldExpression><![CDATA[$F{nombre} == null || $F{nombre}.toString().trim().isEmpty() ? "—" : $F{nombre}.toString()]]></textFieldExpression></textField>
